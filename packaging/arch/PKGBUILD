# Maintainer: runewasneverhere <279159721+runewasneverhere@users.noreply.github.com>
pkgname=bulb-lang
pkgver=0.1.0
pkgrel=1
pkgdesc='small experimental programming language compiled through C'
arch=('any')
url='https://github.com/runewasneverhere/bulb-lang'
license=('GPL-3.0-or-later')
depends=('python')
optdepends=('gcc: compile generated C into native executables')
source=("bulb-lang-${pkgver}.tar.gz::https://github.com/${url#https://github.com/}/archive/refs/tags/v${pkgver}.tar.gz")
sha256sums=('720661b066400e2ee80278452b562f1e5b10d10de5688680f7ebd1899a0c5aa4')

package() {
    cd "${srcdir}/bulb-lang-${pkgver}"

    install -Dm755 bulb.py "${pkgdir}/usr/lib/bulb/bulb.py"
    install -Dm755 packaging/arch/bulb "${pkgdir}/usr/bin/bulb"
    install -Dm644 LICENSE "${pkgdir}/usr/share/licenses/${pkgname}/LICENSE"
    install -Dm644 COPYRIGHT "${pkgdir}/usr/share/doc/${pkgname}/COPYRIGHT"
    install -Dm644 README.md "${pkgdir}/usr/share/doc/${pkgname}/README.md"
}